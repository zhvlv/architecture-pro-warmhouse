@startuml
!include <C4/C4_Container>
!include ./_style.puml
title Тёплый дом — целевые контейнеры и владение данными
LAYOUT_TOP_DOWN()
Person(owner, "Владелец дома")
System_Ext(iam, "OIDC-провайдер", "Вход и токены доступа")
System_Ext(physical, "Устройства партнёров", "Отопление, свет, ворота, камеры, новые типы")
System_Boundary(platform, "Тёплый дом SaaS — To-Be") {
 Container(web, "Веб-приложение", "Web", "Самообслуживание, телеметрия", $tags="planned")
 Container(gateway, "API Gateway / BFF", "HTTPS/JSON", "JWT, маршрутизация; MVP использует Go-фасад", $tags="planned")
 Container(homes, "Дома и модули", "REST", "Владельцы, дома, каталог и активированные модули", $tags="planned")
 Container(devices, "Управление устройствами", "Java 21", "Регистрация, команды; в MVP симуляция", $tags="mvp")
 Container(telemetry, "Телеметрия", "Python 3.12", "Измерения и история; в MVP REST pull", $tags="mvp")
 Container(automation, "Сценарии", "REST + worker", "Правила, действия, запуски", $tags="planned")
 ContainerDb(homesdb, "БД домов и модулей", "PostgreSQL", "Владелец: сервис домов", $tags="planned")
 ContainerDb(devicesdb, "БД устройств", "PostgreSQL", "Метаданные, состояния, команды", $tags="mvp")
 ContainerDb(telemetrydb, "БД телеметрии", "PostgreSQL", "Измерения; отдельные учётные данные", $tags="mvp")
 ContainerDb(automationdb, "БД сценариев", "PostgreSQL", "Правила, действия и запуски", $tags="planned")
 Container(mqtt, "Шлюз устройств", "MQTT/TLS + HTTPS adapters", "Подключения устройств, команды и показания", $tags="planned")
 Container(events, "Брокер доменных событий", "RabbitMQ", "telemetry.recorded, device.registered, command.completed; outbox и идемпотентные потребители", $tags="planned")
 Container(media, "Медиашлюз", "WebRTC / RTSP", "Видеоканал, временные сессии", $tags="planned")
}
Rel(owner, web, "Управляет домом", "HTTPS")
Rel(web, iam, "Вход пользователя", "OIDC + PKCE")
Rel(web, gateway, "Вызывает API", "HTTPS, Bearer JWT")
Rel(gateway, iam, "Ключи проверки JWT", "JWKS")
Rel(gateway, homes, "Дома и модули", "REST")
Rel(gateway, devices, "Регистрация и команды", "REST")
Rel(gateway, telemetry, "Последние показания и история", "REST")
Rel(gateway, automation, "Настройка и запуск правил", "REST")
Rel(homes, homesdb, "Читает и изменяет", "SQL")
Rel(devices, devicesdb, "Читает и изменяет", "SQL")
Rel(telemetry, telemetrydb, "Добавляет и читает измерения", "SQL")
Rel(automation, automationdb, "Читает правила; пишет результаты", "SQL")
Rel(devices, homes, "Проверяет дом и модуль", "REST")
Rel(devices, mqtt, "Команды и подтверждения", "MQTT/TLS")
Rel(physical, mqtt, "Показания и подтверждения", "MQTT/TLS или HTTPS")
Rel(mqtt, telemetry, "Измерения", "Входящий поток событий")
Rel(telemetry, events, "telemetry.recorded", "AMQP, outbox")
Rel(devices, events, "device.registered; command.completed", "AMQP, outbox")
Rel(events, automation, "События измерений и команд", "AMQP, at-least-once")
Rel(automation, devices, "Команды", "REST; целевой контракт")
Rel(devices, media, "Сессия камеры", "Внутренний API")
Rel(physical, media, "Видеопоток", "RTSP / WebRTC")
Rel(web, media, "Видеопоток по временной сессии", "WebRTC, краткоживущий токен")
SHOW_LEGEND()
@enduml
